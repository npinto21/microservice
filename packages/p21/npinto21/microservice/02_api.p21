func UseLogger(target: obj) : obj {
    middleware, err := microservice_native.middleware_logger()
    if (err != null) error(err)
    applied, applyErr := microservice_native.apply_middleware(target, middleware)
    _applied := applied
    if (applyErr != null) error(applyErr)
    return target
}

