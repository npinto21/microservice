package p21.npinto21.microservice

use microservice_native

func New(config: obj) : obj {
    server, err := microservice_native.server_new(config)
    if (err != null) error(err)
    return server
}

func Group(server: obj, prefix: string) : obj {
    group, err := microservice_native.server_group(server, prefix)
    if (err != null) error(err)
    return group
}

func Use(target: obj, middleware: obj) : obj {
    _, err := microservice_native.apply_middleware(target, middleware)
    if (err != null) error(err)
    return target
}

func Get(target: obj, path: string, handler: func) : obj {
    _, err := microservice_native.route_get(target, path, handler)
    if (err != null) error(err)
    return target
}

func Post(target: obj, path: string, handler: func) : obj {
    _, err := microservice_native.route_post(target, path, handler)
