func HasError(err: obj) : bool {
    return err != null
}

func ErrorKind(err: obj) : string {
    if (err == null) return ""
    return err.kind
}

func ErrorMessage(err: obj) : string {
    if (err == null) return ""
    return err.message
}

func ErrorSource(err: obj) : string {
    if (err == null) return ""
    return err.source
}

func Raise(err: obj) {
    if (err != null) error(err)
}

func Ok(ctx: obj, body: obj) {
    statusResult, err := microservice_native.ctx_status(ctx, StatusOk)
    _statusResult := statusResult
    if (err != null) error(err)
    jsonResult, jsonErr := microservice_native.ctx_json(ctx, body)
    _jsonResult := jsonResult
    if (jsonErr != null) error(jsonErr)
}

func Created(ctx: obj, body: obj) {
    statusResult, err := microservice_native.ctx_status(ctx, StatusCreated)
    _statusResult := statusResult
    if (err != null) error(err)
    jsonResult, jsonErr := microservice_native.ctx_json(ctx, body)
    _jsonResult := jsonResult
    if (jsonErr != null) error(jsonErr)
}

func NoContent(ctx: obj) {
    statusResult, err := microservice_native.ctx_status(ctx, StatusNoContent)
    _statusResult := statusResult
    if (err != null) error(err)
    jsonResult, jsonErr := microservice_native.ctx_json(ctx, {})
    _jsonResult := jsonResult
    if (jsonErr != null) error(jsonErr)
}

func ErrorJson(ctx: obj, code: int, message: string) {
    statusResult, err := microservice_native.ctx_status(ctx, code)
    _statusResult := statusResult
    if (err != null) error(err)
    jsonResult, jsonErr := microservice_native.ctx_json(ctx, { error: message })
    _jsonResult := jsonResult
    if (jsonErr != null) error(jsonErr)
}
