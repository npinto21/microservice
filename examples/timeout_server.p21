package p21

use p21.npinto21.microservice

func slow(ctx: obj) {
    microservice.LogInfo("slow handler started", {
        request_id: microservice.RequestId(ctx),
        deadline_ms: microservice.CtxDeadlineMs(ctx)
    })

    microservice.TestSleepMs(1500)

    microservice.LogInfo("slow handler resumed", {
        cancelled: microservice.CtxIsCancelled(ctx),
        cancel_reason: microservice.CtxCancelReason(ctx)
    })
    microservice.Ok(ctx, {
        ok: true,
        request_id: microservice.RequestId(ctx)
    })
}

server := microservice.New({
    port: 8021,
    host: "127.0.0.1",
    request_timeout: 1,
    read_timeout: 10,
    write_timeout: 10,
    shutdown_timeout: 5
})

microservice.UseLogger(server)
microservice.EnableHealth(server)
microservice.Get(server, "/slow", slow)
microservice.LogInfo("timeout server starting", { port: 8021, host: "127.0.0.1", request_timeout: 1 })
microservice.Start(server)
